{
  "name": "sayfern",
  "version": "0.22.0",
  "private": true,
  "description": "Free, open-source, AI-native language learning for macOS",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/brand-oauth-page.mjs && install-electron && node scripts/brand-electron-app.mjs",
    "predev": "node scripts/brand-oauth-page.mjs && install-electron && node scripts/brand-electron-app.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "node scripts/brand-electron-app.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p bench/tsconfig.json",
    "smoke": "tsx scripts/smoke.ts",
    "bench": "tsx bench/bench.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "jszip": "^3.10.2",
    "kuromoji": "^0.1.2",
    "pdfjs-dist": "^6.3.289",
    "pinyin-pro": "^3.29.4"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "author": "Yufeng Liu"
}
